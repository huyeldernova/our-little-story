# Our Little Story - local .env (KHÔNG commit file này)

# ---- Database (MySQL 8) ----
DB_URL=jdbc:mysql://localhost:3306/our_little_story?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me-local-db-password

# ---- Hai tài khoản (chỉ được tạo ở lần chạy đầu tiên) ----
# user1 = Huy (người viết câu chuyện, gửi lời mời); user2 = Giao (người được mời)
# Mật khẩu tối thiểu 10 ký tự
OLS_USER1_USERNAME=author
OLS_USER1_DISPLAY_NAME=Author
OLS_USER1_PASSWORD=change-me-user1-password
OLS_USER2_USERNAME=guest
OLS_USER2_DISPLAY_NAME=Guest
OLS_USER2_PASSWORD=change-me-user2-password
# Đặt true cho MỘT lần chạy nếu muốn đổi mật khẩu, sau đó đặt lại false
OLS_RESET_PASSWORDS=false

# ---- Nội dung câu chuyện thật (chữ + ảnh) ----
OLS_STORY_DIR=/absolute/path/to/story-private

# ---- Ảnh gửi trong chat ----
STORAGE_TYPE=local
UPLOAD_DIR=D:/Giao_Huy/uploads

# ---- Web ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
APP_TIME_ZONE=Asia/Ho_Chi_Minh