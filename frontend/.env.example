# Copy to .env.local for local overrides, or set these in Vercel → Project → Environment Variables.
# Nothing here is secret: every VITE_* value ends up in the public JavaScript bundle.

# Production only: where the Spring Boot API lives, e.g. https://api.example.com
# Leave empty in development (the Vite proxy forwards /api and /ws to localhost:8080).
VITE_API_BASE_URL=

# Development only: where Vite should proxy /api and /ws.
VITE_DEV_BACKEND_URL=http://localhost:8080
